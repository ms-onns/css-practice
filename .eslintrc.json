{
  "env": {
    "browser": false,
    "node": true,
    "es2021": true
  },
  // combine basic linting with Prettier integration
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-console": "off"
  }
}
