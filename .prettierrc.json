{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "plugins": [],
  "overrides": [
    {
      "files": ["*.hbs"],
      "options": {
        "parser": "glimmer"
      }
    },
    {
      "files": ["*.css"],
      "options": {
        "parser": "css"
      }
    }
  ]
}
