<html lang='uk'>
  {{! Змінив на uk, бо контент українською }}
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>CSS Practice | Learning</title>

    {{! Favicon }}
    <link rel='icon' type='image/png' href='/favicon.png?v=4' />

    {{! Google Fonts: Roboto }}
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap'
      rel='stylesheet'
    />

    {{! Normalize (залишаємо для чистоти експерименту) }}
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/modern-normalize/2.0.0/modern-normalize.min.css'
    />

    {{! Bootstrap 5.3.3 }}
    <link
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css'
      rel='stylesheet'
      crossorigin='anonymous'
    />

    {{! Font Awesome 6 (Переніс у Head для швидкого завантаження іконок) }}
    <script
      src='https://kit.fontawesome.com/4a7d77f2b4.js'
      crossorigin='anonymous'
    ></script>

    {{! Твої динамічні стилі — завжди в самому кінці, щоб вони могли "перебивати" Bootstrap }}
    {{#if style}}
      <link rel='stylesheet' href='/css/{{style}}.css' />
    {{else}}
      <link rel='stylesheet' href='/css/index.css' />
    {{/if}}
  </head>

  <body>
    {{{body}}}
    {{! Bootstrap JS (якщо знадобиться для кнопок або модалок) }}
    <script
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js'
    ></script>
  </body>
</html>