<div class='content-space'>
  {{#each cards}}

    <div class='card'>

      <div class='card-body'>
        <h1>{{title}}</h1>
        <p>{{description}}</p>
      </div>

      <div class='price-badge'>
        <h3>{{price}}</h3>

        {{#if tag}}
          <p class='badge'>{{tag}}</p>
        {{/if}}
      </div>

      <div class='card-footer'>
        {{#each actions}}
          <button>{{this}}</button>
        {{/each}}
      </div>

    </div>

  {{/each}}
</div>