<div class='app-layout'>

  <header class='topbar'>
    <div class='logo'>
      <a href='#' class='logo-link'>My<span class='logo-accent'>Store</span></a>
    </div>

    <div class='header-center'>
      <div class='search-bar'>
        <input
          type='text'
          class='search-input'
          placeholder='Search products...'
        />
        <button class='search-btn'>🔍</button>
      </div>

      <nav class='nav-links'>
        <a href='#'>Home</a>
        <a href='#'>Products</a>
        <a href='#'>Cart</a>
      </nav>
    </div>

    <div class='auth-buttons'>
      <button class='login-btn'>Log In</button>
      <button class='register-btn'>Sign Up</button>
    </div>
  </header>

  <aside class='sidebar'>
    <h3 class='side-h3'>Categories</h3>
    <ul class='ul-list'>
      <li class='li-list'><a href='#' class='link-list'>Phones</a></li>
      <li class='li-list'><a href='#' class='link-list'>Laptops</a></li>
      <li class='li-list'><a href='#' class='link-list'>Accessories</a></li>
    </ul>
  </aside>

  <main class='main-content'>

    <div class='products-grid'>

      <div class='card'>

        <img
          src='https://picsum.photos/300/300?random'
          class='card-img'
          alt='iPhone 15 Pro'
        />

        <h4 class='card-title'>iPhone 15 Pro</h4>
        <p class='card-desc'>Титан, 256GB, крута камера.</p>
        <div class='card-bottom'>
          <span class='price'>$999</span>
          <button class='buy-btn'>Buy</button>
        </div>
      </div>

      <div class='card'>
        <img
          src='https://picsum.photos/300/300?random=1'
          class='card-img'
          alt='MacBook Air M2'
        />
        <h4 class='card-title'>MacBook Air M2</h4>
        <p class='card-desc'>Легкий та потужний для роботи.</p>
        <div class='card-bottom'>
          <span class='price'>$1199</span>
          <button class='buy-btn'>Buy</button>
        </div>
      </div>

    </div>

  </main>

  <footer class='footer'>
    <p>© 2026 MyStore. All rights reserved.</p>
  </footer>

</div>